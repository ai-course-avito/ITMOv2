{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmojiCatalogItem",
  "type": "object",
  "required": ["code", "version", "rarity"],
  "properties": {
    "code": { "type": "string" },
    "version": { "type": "string" },
    "rarity": { "type": "string", "enum": ["common", "rare", "very_rare"] },
    "display_name": { "type": "string" },
    "icon_ref": { "type": "string" }
  }
}
