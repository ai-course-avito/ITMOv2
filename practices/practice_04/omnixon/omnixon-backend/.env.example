# App name
APP_NAME="omnixon"
UPSTREAM_PORT="8083"

# Logfire token, depricated
# You can get it from https://logfire.pydantic.dev/
# LOGFIRE_TOKEN="pylf_v1_eu_xxx" # logging shit service, omnixon might work without it

# Postgres config

# Postgres host
POSTGRES_HOST="db"
POSTGRES_PORT="5432"

# Postgres credentials
POSTGRES_USER="user"
POSTGRES_PASSWORD="xxx"
POSTGRES_DB="omnixon-web"

# Api keys
OPENROUTER_API_KEY="sk-or-v1-xxx"
INITIAL_API_KEY="xxx_xxx"

# Optional proxy used for all requests to OpenRouter (http://, https:// or socks5://)
# OPENROUTER_PROXY="socks5://user:password@127.0.0.1:1080"

# Model seeded as model 0 on first start. It is used by agents/units that have
# no model of their own. Either an OpenRouter request body as JSON, or just a
# model name.
# DEFAULT_MODEL='{"model": "z-ai/glm-5.3-20260816", "provider": {"order": ["decart"], "quantizations": ["fp4"]}}'

# A request that takes longer than this is cancelled (504). Default: 600
# REQUEST_TIMEOUT_SECONDS=600
# Failures of the model provider that are likely to pass (5xx, 429, timeouts) are
# retried this many more times, after UPSTREAM_RETRY_DELAY seconds, then twice as
# long. Errors that will not pass (a bad model name) are not retried. Default: 2, 1
# UPSTREAM_RETRIES=2
# UPSTREAM_RETRY_DELAY=1
# An MCP server that does not answer within MCP_PROBE_TIMEOUT seconds is left out of
# the requests of its agents for MCP_DOWN_SECONDS. Default: 5, 30
# MCP_PROBE_TIMEOUT=5
# MCP_DOWN_SECONDS=30
# An MCP tool call that does not get through (connection, timeout, HTTP error) is tried MCP_TOOL_ATTEMPTS
# times in all, MCP_TOOL_RETRY_DELAY seconds apart (doubling); then the model gets the error as the tool's
# result and the answer goes on. Default: 3, 1
# MCP_TOOL_ATTEMPTS=3
# MCP_TOOL_RETRY_DELAY=1
# How many times the model may call an MCP tool again after writing its arguments badly (not valid JSON,
# an unknown tool name). A server's own "max_retries" wins. Default: 3
# MCP_TOOL_RETRIES=3

# Agents learn from every saved conversation (the model is asked in the background what
# is worth remembering about the user; one more model call per request). An agent can
# override it with config {"auto_memory": false}. Default: true
# DEFAULT_AUTO_MEMORY=true

# Messages older than this many days are forgotten (not given to the model, not
# returned as history) and deleted every MESSAGE_CLEANUP_INTERVAL_SECONDS. 0 keeps
# them forever. Memories and agents are not affected. Default: 7
# MESSAGE_TTL_DAYS=7
# MESSAGE_CLEANUP_INTERVAL_SECONDS=3600

# A labelled metric series (one route and status, say) that nothing has touched for this
# many days disappears from /metrics. 0 keeps them forever. Default: 7
# METRICS_TTL_DAYS=7

# Defaults for agents that do not set them in their `config` JSON:
# how many of the latest messages of a user are given to the model, and how many
# memories about a user are shown to it at once (system prompt and `recall` tool).
# DEFAULT_MESSAGE_LIMIT=10
# DEFAULT_MEMO_LIMIT=20
# How many knowledge base entries one search of the `rag` tool gives the model (agent config: rag_limit).
# DEFAULT_RAG_LIMIT=8
# How many agents deep one request may go when agents call each other (ask_agent). Default: 3
# AGENT_CALL_DEPTH=3
# Redis lets several replicas of the api (Swarm) stop each other's streams: Stop and a new message of a user reach the stream wherever it
# runs. Unset: one process, nothing shared. Example: redis://redis:6379/0
# REDIS_URL=

# Lowest level written to the logs, which are JSON lines on stdout:
# debug, info, warning, error. Default: info.
# "debug" also logs the arguments and results of every route and database call
# (API tokens and message texts included), so do not use it in production.
# LOG_LEVEL=info
