FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /bin/

# Git, to work inside the container
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN git config --global core.autocrlf input
RUN git config --global user.email "simeongfremenko@gmail.com"
RUN git config --global user.name "lixelv"

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Dependencies first, to leverage Docker layer caching
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --group test --no-install-project

# Copy the rest of the application
COPY . /app
