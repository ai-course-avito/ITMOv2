    {
      "parameters": {
        "jsCode": "const diff = $input.first().json.data;\nlet path = null;\nlet newLine = 0;\nconst annotated = [];\nconst valid = {};\n\nfor (const l of diff.split('\\n')) {\n  if (l.startsWith('diff --git')) {\n    path = l.split(' b/')[1];\n    continue;\n  }\n  if (l.startsWith('+++') || l.startsWith('---') || l.startsWith('index ')) continue;\n  const m = l.match(/^@@ -\\d+(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n  if (m) {\n    newLine = parseInt(m[1], 10);\n    annotated.push(`\\nFILE: ${path}\\n${l}`);\n    continue;\n  }\n  if (!path) continue;\n  if (l.startsWith('+')) {\n    annotated.push(`${newLine}: ${l}`);\n    (valid[path] = valid[path] || []).push(newLine);\n    newLine++;\n  } else if (l.startsWith(' ')) {\n    annotated.push(`${newLine}: ${l}`);\n    newLine++;\n  }\n}\n\nreturn [{ json: { annotated: annotated.join('\\n'), valid } }];"
      },
