    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || '[]';\nconst clean = raw.replace(/```json|```/g, '').trim();\n\nlet items = [];\ntry { items = JSON.parse(clean); } catch (e) { items = []; }\n\nconst valid = $('parse diff').first().json.valid;\n\nconst comments = items\n  .filter(c => c.path && valid[c.path] && valid[c.path].includes(Number(c.line)))\n  .map(c => ({\n    path: c.path,\n    line: Number(c.line),\n    side: 'RIGHT',\n    body: c.comment\n  }));\n\nreturn [{ json: {\n  body: `**Модель: openai/gpt-5.2**\\n\\nНайдено замечаний: ${comments.length}`,\n  comments\n} }];"
      },
