      "typeVersion": 2,
      "position": [
        224,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload=$input.first().json; const p=payload.body ?? payload; if(p.action!=='opened'||p.repository?.full_name!=='vlklk/itmo-n8n-lab'||p.issue?.pull_request||!Number.isSafeInteger(p.issue?.number)) return [];const x=p.issue;return [{json:{number:x.number,title:String(x.title??''),body:String(x.body??''),labels:(x.labels??[]).map(l=>l.name).filter(Boolean)}}];"
      }
    },
