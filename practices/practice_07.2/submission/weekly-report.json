        "operation": "send",
        "sendTo": "SET_RECIPIENT@example.invalid",
        "subject": "ИТМО — статистика GitHub за неделю",
        "emailType": "html",
        "message": "={{ $json.html }}"
      },
      "webhookId": "8c17b0a2-ad31-4623-ac3f-2624f93d0d17"
    }
  ],
