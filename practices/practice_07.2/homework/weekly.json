    {
      "parameters": {
        "promptType": "define",
        "text": "=Напиши по-русски 2–3 коротких предложения для недельного отчёта. Используй только переданные числа: объём обращений, основные типы и изменения к прошлой неделе. Не выдумывай причины изменений. Если прошлой недели нет — укажи это. Если previous.simulated=true — прямо назови сравнение учебным, с тестовой прошлой неделей. Не используй Markdown или HTML. Данные: {{ JSON.stringify($json) }}"
      },
      "name": "AI-комментарий недели",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        2192,
        112
      ],
      "typeVersion": 1.6,
      "id": "da1b9d61-5d3f-44a0-85c1-d0d60d1ad503"
