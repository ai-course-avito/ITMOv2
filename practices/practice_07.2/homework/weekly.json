    },
    {
      "parameters": {
        "jsCode": "const current=$('Группировка по типу и автору').first().json;const rows=$input.all().map(x=>x.json).filter(x=>x.week_key===current.previous_key);if(rows.length>1)throw new Error('В таблице несколько записей одной недели');const previous=rows.length?JSON.parse(rows[0].stats_json):null;const delta={};for(const t of Object.keys(current.by_type))delta[t]=previous?current.by_type[t]-(previous.by_type[t]??0):null;const author_delta={};for(const a of new Set([...Object.keys(current.by_author),...Object.keys(previous?.by_author??{})]))author_delta[a]=(current.by_author[a]?.total??0)-(previous?.by_author[a]?.total??0);return [{json:{...current,previous,delta,author_delta,total_delta:previous?current.total-previous.total:null}}];"
      },
