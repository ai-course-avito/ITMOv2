    {
      "parameters": {
        "jsCode": "const d=$('Изменение за неделю').first().json;const ai=$json.text??$json.output;if(typeof ai!=='string'||!ai.trim())throw new Error('AI не вернул аннотацию');\nconst esc=x=>String(x).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));const fmt=x=>x===null?'нет данных':(x>0?'+':'')+x;\nconst labels={bug:'Ошибки',task:'Задачи',feature:'Новые возможности',unknown:'Требуют уточнения'};\nconst types=Object.entries(d.by_type).map(([t,count])=>`<tr><td>${labels[t]}</td><td>${count}</td><td>${d.previous?.by_type[t]??'—'}</td><td>${fmt(d.delta[t])}</td></tr>`).join('');\nconst authors=Object.entries(d.by_author).sort((a,b)=>b[1].total-a[1].total).map(([a,v])=>`<tr><td>${esc(a)}</td><td>${v.bug}</td><td>${v.task}</td><td>${v.feature}</td><td>${v.unknown}</td><td>${v.total}</td><td>${d.previous?fmt(d.author_delta[a]):'нет данных'}</td></tr>`).join('');\nconst previousNote=d.previous?.simulated?'Предыдущая неделя — явно помеченная учебная запись для проверки Δ.':d.previous?'Сравнение с сохранённой предыдущей неделей.':'Данных прошлой недели нет; Δ не вычислен.';\nconst html=`<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\"></head><body style=\"font-family:Arial,sans-serif\"><h1>Недельный отчёт по Issues</h1><p>bronY9/ITMOv2 · ${esc(d.period_start)} — ${esc(d.period_end)}</p><p>${previousNote}</p><table border=\"1\" cellpadding=\"8\" cellspacing=\"0\"><tr><th>Тип</th><th>Сейчас</th><th>Ранее</th><th>Δ</th></tr>${types}<tr><th>Всего</th><th>${d.total}</th><th>${d.previous?.total??'—'}</th><th>${fmt(d.total_delta)}</th></tr></table><h2>По авторам</h2><table border=\"1\" cellpadding=\"8\" cellspacing=\"0\"><tr><th>Автор</th><th>bug</th><th>task</th><th>feature</th><th>unknown</th><th>Всего</th><th>Δ</th></tr>${authors}</table><h2>AI-комментарий недели</h2><p>${esc(ai)}</p></body></html>`;\nconst stats={by_type:d.by_type,by_author:d.by_author,total:d.total,simulated:false};return [{json:{...d,html,ai_comment:ai,subject:'Issues ITMOv2 — неделя '+d.week_key,stats_json:JSON.stringify(stats)}}];"
      },
