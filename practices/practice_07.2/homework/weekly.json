    {
      "parameters": {
        "jsCode": "const sources=[['bug','Запрос bug'],['task','Запрос task'],['feature','Запрос feature-request'],['unknown','Запрос needs-triage']];\nconst by_type={bug:0,task:0,feature:0,unknown:0},by_author={},seen=new Set();\nfor(const [type,name] of sources){const data=$(name).first().json;if(data.incomplete_results||data.total_count>100)throw new Error('Результат GitHub обрезан: требуется пагинация');for(const issue of data.items??[]){if(seen.has(issue.id))continue;seen.add(issue.id);by_type[type]++;const a=issue.user.login;if(!by_author[a])by_author[a]={bug:0,task:0,feature:0,unknown:0,total:0};by_author[a][type]++;by_author[a].total++;}}\nreturn [{json:{...$('Период отчёта').first().json,by_type,by_author,total:seen.size,simulated:false}}];"
      },
