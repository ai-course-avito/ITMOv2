      "name": "Модель для аннотации",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        2192,
        352
      ],
      "typeVersion": 1.2,
      "id": "2b7b5302-6140-4d23-b7e2-a72d0ac675dd",
