      "parameters": {
        "jsCode": "// При ручной проверке берём последние 7 дней; в понедельник — ровно прошлую неделю до 09:00.\nconst end=$now.startOf('second');const start=end.minus({days:7});\nreturn [{json:{period_start:start.toUTC().toISO({suppressMilliseconds:true}),period_end:end.toUTC().toISO({suppressMilliseconds:true}),week_key:end.startOf('week').toISODate(),previous_key:end.startOf('week').minus({weeks:1}).toISODate(),recipient:'YOUR_EMAIL@example.com'}}];"
