    {
      "name": "Проверить правку и граничные дни",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const proposed = $input.first().json.text;\nif (typeof proposed !== 'string') throw new Error('Нет ответа модели');\nconst line = proposed.trim();\nconst match = /^return day === ([0-7]) \\|\\| day === ([0-7]);$/.exec(line);\nif (!match) throw new Error('Допустима только одна строка с двумя строгими сравнениями');\nconst [a,b] = match.slice(1).map(Number);\n// Узкая грамматика выше гарантирует ровно эту семантику. Не исполняем текст модели.\nconst tests = [-1,0,1,2,3,4,5,6,7,8,'0','6',null].map(day => {\n  const expected = day === 0 || day === 6;\n  return {day, expected, actual: day === a || day === b};\n});\nif (tests.some(t => t.actual !== t.expected)) throw new Error('Правка не прошла проверки дней недели');\nconst source = $(\"Подготовить исходник\").first().json;\nconst fixed = source.original.replace(\"  return day === 6 || day === 7;\", '  '+line);\nreturn [{json:{fixed,line,tests,encoded:Buffer.from(fixed,'utf8').toString('base64')}}];"
      },
      "id": "13fa5084-18b3-4d73-b2b7-d67d5ca783dc",
      "position": [
        0,
        430
      ]
