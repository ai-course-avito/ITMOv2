    {
      "name": "Сверить коммит и состав правки",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const c = $input.first().json;\nconst pr = $(\"Открыть Pull Request\").first().json;\nconst change = $(\"Записать исправление\").first().json;\nconst expected = $(\"Проверить правку и граничные дни\").first().json;\nconst base = $(\"Подготовить исходник\").first().json.base;\nconst file = c.files?.[0];\nif (!pr.number || pr.base.ref !== 'main' || pr.base.sha !== base ||\n    pr.head.ref !== $(\"Разрешённый учебный баг\").first().json.branch || pr.head.sha !== change.commit.sha ||\n    c.ahead_by !== 1 || c.behind_by !== 0 || c.commits?.length !== 1 ||\n    c.commits[0].sha !== pr.head.sha || c.files?.length !== 1 ||\n    file.filename !== $(\"Разрешённый учебный баг\").first().json.path || file.status !== 'modified' || file.additions !== 1 ||\n    file.deletions !== 1 || file.sha !== change.content.sha ||\n    !file.patch?.split('\\n').includes('-'+\"  return day === 6 || day === 7;\") ||\n    !file.patch.split('\\n').includes('+  '+expected.line)) {\n  throw new Error('Опубликованная правка отличается от проверенной');\n}\nreturn [{json:{patch:file.patch,sha:pr.head.sha,number:pr.number,tests:expected.tests}}];"
      },
