    {
      "name": "Подготовить исходник",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const f = $input.first().json;\nconst original = \"// JavaScript getDay(): Sunday = 0, Saturday = 6.\\nexport function isWeekend(day) {\\n  return day === 6 || day === 7;\\n}\\n\";\nif (f.type !== 'file' || f.encoding !== 'base64' || f.path !== $(\"Разрешённый учебный баг\").first().json.path ||\n    f.content.replace(/\\s/g,'') !== Buffer.from(original,'utf8').toString('base64') ||\n    !/^[0-9a-f]{40}$/.test(f.sha)) {\n  throw new Error('Файл уже исправлен или его содержимое отличается от учебного исходника');\n}\nreturn [{json:{report:$(\"Разрешённый учебный баг\").first().json.body, original, blobSha:f.sha, base:$(\"SHA основной ветки\").first().json.object.sha}}];"
      },
      "id": "1f150743-5b04-460f-b0a9-ce72ad4fa33e",
      "position": [
        1200,
