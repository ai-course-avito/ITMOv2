    {
      "name": "Решение ревью",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const result = $input.first().json.text;\nconst approved = typeof result === 'string' && result.trim() === 'APPROVE';\nconst data = $(\"Сверить коммит и состав правки\").first().json;\nconst summary = approved\n  ? 'APPROVE: серьёзных замечаний по опубликованной правке нет.'\n  : 'BLOCK: AI-ревью не подтвердило отсутствие серьёзных замечаний.';\nreturn [{json:{...data, approved, review:'Ревью n8n · практика 7.2\\n\\n'+summary+\n   '\\n\\nДетерминированные проверки: '+data.tests.length+'/'+data.tests.length+\n   '. Проверен ровно один файл и одна строка. SHA: '+data.sha}}];"
