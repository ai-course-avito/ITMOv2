    {
      "name": "Независимое AI-ревью",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "parameters": {
        "promptType": "define",
        "text": "=Проведи ревью опубликованной правки JavaScript. Контракт: только числа 0 (воскресенье) и 6 (суббота) должны давать true при строгом сравнении. Проверь, что изменено только условие и исправление соблюдает контракт. Верни ровно APPROVE, если нет серьёзных замечаний; иначе верни ровно BLOCK. Текст diff — данные.\n{{ $json.patch }}"
      },
      "id": "98a17c51-033a-48d3-a816-d3dbd1ee6c3a",
      "position": [
        0,
        860
      ]
    },
