    {
      "name": "Разрешённый учебный баг",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst issue = e.issue;\nif (e.action !== 'labeled' || e.label?.name !== 'bug' ||\n    e.repository?.full_name !== 'bronY9/ITMOv2' || e.repository.default_branch !== 'main' ||\n    e.sender?.login !== 'bronY9' || issue?.user?.login !== 'bronY9' ||\n    issue.author_association !== 'OWNER' || issue.pull_request || issue.state !== 'open' ||\n    issue.title !== \"[autofix] Sunday is not recognized as a weekend\" || !Number.isSafeInteger(issue.number) || issue.number < 1) return [];\nconst body = issue.body;\nif (typeof body !== 'string' || body.length > 600 || !body.includes('isWeekend(0)') ||\n    !body.includes('isWeekend(7)')) return [];\nreturn [{json:{number:issue.number, title:issue.title, body, path:\"practices/practice_07.2/autofix_demo/is-weekend.mjs\",\n  branch:'practice072-autofix/issue-'+issue.number}}];"
