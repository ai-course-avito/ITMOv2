      "parameters": {
        "jsCode": "const currentIssue = Number($('GitHub Webhook (Issues)').first().json.body.issue.number);\nconst tableRows = $('Check Data Table (processed_issues)').all();\n\nconst isAlreadyProcessed = tableRows.some(row => Number(row.json.issue_id) === currentIssue);\n\nif (isAlreadyProcessed) {\n  // Уже обработан -> выходим\n  return [];\n}\n\nreturn [{\n  json: {\n    issue_id: currentIssue,\n    title: $('GitHub Webhook (Issues)').first().json.body.issue.title,\n    body: $('GitHub Webhook (Issues)').first().json.body.issue.body || '',\n    repo: $('GitHub Webhook (Issues)').first().json.body.repository.full_name\n  }\n}];"
