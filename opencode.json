{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "skills": {
    "paths": ["skills"]
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "pptx-reader": {
      "type": "local",
      "command": ["python3", "mcp/pptx-reader/server.py"],
      "enabled": true
    }
  },
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": { "name": "openai/gpt-5" },
        "anthropic/claude-sonnet-4": { "name": "anthropic/claude-sonnet-4" }
      }
    }
  }
}